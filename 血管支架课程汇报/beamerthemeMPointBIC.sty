\newcommand{\BICMakeTitle}{%
  \begin{frame}
    \begin{tikzpicture}[remember picture,overlay]
      \node[
        anchor=center,
        inner sep=0pt,
        align=center,
        font=\usebeamerfont{title},
        text=BICDeepRed
      ] at ([yshift=-.4042\paperheight]current page.north)
      {\inserttitle};

      \node[
        anchor=north west,
        inner sep=0pt,
        text width=.340\paperwidth,
        align=left,
        text=BICNavy,
        font=\usebeamerfont{BIC metadata}
      ] at ([xshift=.366\paperwidth,yshift=-.6453\paperheight]current page.north west)
      {汇报人：\BICReporterValue\\
       年级：\BICGradeValue\\
       导师：\BICAdvisorValue\\
       时间：\BICDateValue};
    \end{tikzpicture}
  \end{frame}%
}

