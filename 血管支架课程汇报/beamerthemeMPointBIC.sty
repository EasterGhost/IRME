\mode<presentation>
\usefonttheme{professionalfonts}

% Match the source PowerPoint widescreen canvas exactly. Rendering this page
% at 144 dpi produces 1920 x 1080 pixels without raster rescaling.
\geometry{paperwidth=13.333333in,paperheight=7.5in}

